---
import { EMAIL, LINKEDIN_URL, waLink } from "../lib/contact";

const year = new Date().getFullYear();
const waHref = waLink("Hola Pablo, vi tu sitio y tengo una consulta 💬");
---

<footer class="site-footer">
  <div class="container footer-inner">
    <span>&copy; {year} Pablo Cornejo · Webs y software en Chile</span>
    <ul class="footer-links">
      <li><a href={`mailto:${EMAIL}`} data-cta="footer-email">Email</a></li>
      <li>
        <a href={waHref} target="_blank" rel="noopener" data-cta="footer-whatsapp"
          >WhatsApp <span class="visually-hidden">(se abre en una nueva pestaña)</span></a
        >
      </li>
      <li>
        <a href={LINKEDIN_URL} target="_blank" rel="noopener"
          >LinkedIn <span class="visually-hidden">(se abre en una nueva pestaña)</span></a
        >
      </li>
      <li>
        <button type="button" class="motion-toggle">Pausar animaciones</button>
      </li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-base);
    color: var(--text-tertiary);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--border-subtle);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-links a,
  .motion-toggle {
    text-decoration: none;
    color: var(--text-tertiary);
    transition: color 0.15s;
  }

  .motion-toggle {
    font: inherit;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible,
  .motion-toggle:hover,
  .motion-toggle:focus-visible {
    color: var(--cyan);
  }
</style>

<script>
  // WCAG 2.2.2: the hero glow and the showcase mockup loop indefinitely, so
  // give visitors a way to stop them. The choice is remembered per browser.
  const toggle = document.querySelector<HTMLButtonElement>(".motion-toggle");
  const root = document.documentElement;

  if (toggle) {
    const render = () => {
      const paused = root.classList.contains("motion-paused");
      toggle.textContent = paused ? "Reanudar animaciones" : "Pausar animaciones";
    };

    toggle.addEventListener("click", () => {
      const paused = root.classList.toggle("motion-paused");
      try {
        if (paused) localStorage.setItem("motion", "paused");
        else localStorage.removeItem("motion");
      } catch {
        // Storage unavailable (private mode, blocked): the toggle still
        // works for this visit.
      }
      render();
    });

    render();
  }
</script>

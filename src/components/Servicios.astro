---
import { waLink } from "../lib/contact";

const services = [
  {
    title: "Páginas web",
    intro:
      "Diseño y desarrollo tu página para que se vea profesional, cargue rápido y funcione bien en el celular, así quien te busca te encuentra y te escribe.",
    items: [
      {
        title: "Landing page",
        text: "Una sola página, directa y bien diseñada, para presentar tu negocio y recibir contactos.",
      },
      {
        title: "Sitio corporativo",
        text: "Varias secciones (servicios, quiénes somos, contacto) para empresas que necesitan mostrar más.",
      },
    ],
    cta: "Cotizar mi página web",
    message: "Hola Pablo, quiero cotizar una página web para mi negocio 👋",
  },
  {
    title: "Tiendas online",
    intro:
      "Tu tienda con carrito de compra, para vender por internet a toda hora y recibir pedidos sin estar pendiente del teléfono.",
    items: [
      {
        title: "Carrito y pagos online",
        text: "Tus clientes eligen, pagan y compran solos, a cualquier hora.",
      },
      {
        title: "Catálogo de productos",
        text: "Tus productos ordenados por categoría, con fotos, stock y precios que actualizas tú mismo.",
      },
      {
        title: "Panel de pedidos",
        text: "Un panel simple para ver tus ventas, gestionar pedidos y controlar el stock desde el celular o el computador.",
      },
    ],
    cta: "Cotizar mi tienda online",
    message: "Hola Pablo, quiero cotizar una tienda online 🛒",
  },
  {
    title: "Software a medida",
    intro:
      "Si tu negocio funciona con planillas, cuadernos y mensajes sueltos, te armo un sistema que lo ordene: inventario, agenda, cotizaciones o lo que necesites.",
    items: [
      {
        title: "Sistemas internos",
        text: "Una herramienta hecha para cómo trabajas tú, pensada para crecer sin tener que rehacerla en un año.",
      },
      {
        title: "Integración con IA",
        text: "Sumo IA a tareas que hoy haces a mano, como ordenar datos o resumir documentos, y conecto tus sistemas para que no copies información de un lado a otro.",
      },
      {
        title: "Renovar sistemas antiguos",
        text: "Si tienes un sistema viejo que ya cuesta mantener, lo paso a tecnología actual en la nube sin detener tu operación.",
      },
    ],
    cta: "Cotizar mi sistema",
    message: "Hola Pablo, quiero cotizar un software a medida para mi negocio ⚙️",
  },
];
---

<section class="services" id="servicios">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" style="justify-content:center;">Servicios</span>
      <h2>En qué te puedo ayudar</h2>
      <p>
        Desde una página para que te encuentren hasta un sistema hecho según cómo trabaja tu
        negocio.
      </p>
    </div>
    <div class="cat-grid">
      {
        services.map((s, i) => (
          <div class="cat-card reveal corner-brackets">
            <span class="cat-tag">// 0{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.intro}</p>
            <ul class="cat-items">
              {s.items.map((item) => (
                <li>
                  <h4>{item.title}</h4>
                  <p>{item.text}</p>
                </li>
              ))}
            </ul>
            <a
              href={waLink(s.message)}
              target="_blank"
              rel="noopener"
              class="btn btn-secondary btn-sm cat-cta"
              data-cta={`servicio-${i + 1}-whatsapp`}
            >
              {s.cta}
              <span class="visually-hidden">por WhatsApp (se abre en una nueva pestaña)</span>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .cat-card {
    position: relative;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.25s ease;
  }

  .cat-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow:
      0 0 0 1px rgba(var(--cyan-rgb), 0.25),
      0 20px 44px -22px rgba(var(--magenta-rgb), 0.4);
  }

  .cat-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--green);
    text-shadow: 0 0 8px rgba(var(--green-rgb), 0.5);
    letter-spacing: 0.08em;
  }

  .cat-card h3 {
    font-family: var(--font-sub);
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--text-primary);
  }

  .cat-card > p {
    font-family: var(--font-body);
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  .cat-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex: 1;
  }

  .cat-items li {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-4);
  }

  .cat-items h4 {
    font-family: var(--font-sub);
    font-size: 1.0625rem;
    font-weight: 700;
    margin-bottom: 4px;
    color: var(--cyan);
  }

  .cat-items p {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .cat-cta {
    align-self: flex-start;
    margin-top: var(--space-2);
  }

  @media (max-width: 960px) {
    .cat-grid {
      grid-template-columns: 1fr;
      max-width: 520px;
      margin-inline: auto;
    }
  }
</style>

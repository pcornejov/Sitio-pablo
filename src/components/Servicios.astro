---
import { waLink } from "../lib/contact";

const services = [
  {
    title: "Páginas web",
    intro:
      "Una página donde el cliente que te busca encuentra qué haces y cómo contactarte, sin vueltas. La hago rápida y cómoda en el celular, porque desde ahí entra la mayoría.",
    items: [
      {
        title: "Landing page",
        text: "Una sola página con lo esencial. Sirve harto si recién estás partiendo o si vendes un solo servicio.",
      },
      {
        title: "Sitio corporativo",
        text: "Varias secciones, para empresas que necesitan más espacio para explicar lo que hacen.",
      },
    ],
    cta: "Quiero una página web",
    message: "Hola Pablo, quiero cotizar una página web para mi negocio 👋",
  },
  {
    title: "Tiendas online",
    intro:
      "Tu catálogo en internet, con carrito y pago online. El cliente compra a las 11 de la noche y tú ves el pedido en la mañana.",
    items: [
      {
        title: "Carrito y pagos online",
        text: "El cliente paga ahí mismo, sin tener que escribirte para coordinar.",
      },
      {
        title: "Catálogo de productos",
        text: "Subes fotos, cambias precios y actualizas el stock tú mismo, sin llamarme cada vez.",
      },
      {
        title: "Panel de pedidos",
        text: "Ves lo que se vendió, lo que falta despachar y cuánto stock te queda. Funciona en el celular.",
      },
    ],
    cta: "Quiero una tienda online",
    message: "Hola Pablo, quiero cotizar una tienda online 🛒",
  },
  {
    title: "Software a medida",
    intro:
      "Si hoy llevas el negocio en planillas de Excel y chats de WhatsApp, te armo un sistema que lo ordene. Hecho para cómo trabajas tú, no un programa genérico al que te tienes que acomodar.",
    items: [
      {
        title: "Sistemas internos",
        text: "Por ejemplo, un inventario que se descuenta solo con cada venta, o una agenda que no dependa de un cuaderno.",
      },
      {
        title: "Integración con IA",
        text: "Uso IA para sacarte de encima tareas repetitivas, como pasar datos de un correo a una planilla o resumir documentos largos.",
      },
      {
        title: "Renovar sistemas antiguos",
        text: "¿Tienes un sistema viejo que nadie se atreve a tocar? Lo paso a tecnología actual sin parar tu operación.",
      },
    ],
    cta: "Cuéntame tu idea",
    message: "Hola Pablo, quiero cotizar un software a medida para mi negocio ⚙️",
  },
];
---

<section class="services" id="servicios">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow" style="justify-content:center;">Servicios</span>
      <h2>Lo que hago</h2>
      <p>
        Principalmente estas tres cosas. Si lo tuyo no calza en ninguna, escríbeme igual y lo
        vemos.
      </p>
    </div>
    <div class="cat-grid">
      {
        services.map((s, i) => (
          <div class="cat-card reveal corner-brackets">
            <span class="cat-tag">// 0{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.intro}</p>
            <ul class="cat-items">
              {s.items.map((item) => (
                <li>
                  <h4>{item.title}</h4>
                  <p>{item.text}</p>
                </li>
              ))}
            </ul>
            <a
              href={waLink(s.message)}
              target="_blank"
              rel="noopener"
              class="btn btn-secondary btn-sm cat-cta"
              data-cta={`servicio-${i + 1}-whatsapp`}
            >
              {s.cta}
              <span class="visually-hidden">por WhatsApp (se abre en una nueva pestaña)</span>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .cat-card {
    position: relative;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.25s ease;
  }

  .cat-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow:
      0 0 0 1px rgba(var(--cyan-rgb), 0.25),
      0 20px 44px -22px rgba(var(--magenta-rgb), 0.4);
  }

  .cat-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--green);
    text-shadow: 0 0 8px rgba(var(--green-rgb), 0.5);
    letter-spacing: 0.08em;
  }

  .cat-card h3 {
    font-family: var(--font-sub);
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--text-primary);
  }

  .cat-card > p {
    font-family: var(--font-body);
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  .cat-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex: 1;
  }

  .cat-items li {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-4);
  }

  .cat-items h4 {
    font-family: var(--font-sub);
    font-size: 1.0625rem;
    font-weight: 700;
    margin-bottom: 4px;
    color: var(--cyan);
  }

  .cat-items p {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .cat-cta {
    align-self: flex-start;
    margin-top: var(--space-2);
  }

  @media (max-width: 960px) {
    .cat-grid {
      grid-template-columns: 1fr;
      max-width: 520px;
      margin-inline: auto;
    }
  }
</style>

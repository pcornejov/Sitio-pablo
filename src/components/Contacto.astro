---
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { EMAIL, LINKEDIN_URL, WA_DISPLAY, waLink } from "../lib/contact";

const waHref = waLink("Hola Pablo, vi tu sitio web y me interesa conversar sobre un proyecto 👋");
---

<section class="contact" id="contacto">
  <div class="container">
    <div class="contact-card corner-brackets">
      <span class="eyebrow">Contacto</span>
      <h2>¿Conversamos?</h2>
      <p>
        Cuéntame qué tienes en mente. Te hago un par de preguntas y te mando una cotización por
        escrito. Si al final no te convence, no pasa nada.
      </p>

      <a
        href={waHref}
        target="_blank"
        rel="noopener"
        class="btn btn-primary contact-wa"
        data-cta="contacto-whatsapp"
      >
        <WhatsAppIcon size={22} />
        Escríbeme por WhatsApp
        <span class="visually-hidden">(se abre en una nueva pestaña)</span>
      </a>
      <p class="contact-number">{WA_DISPLAY}</p>

      <div class="contact-divider" aria-hidden="true"><span>o si prefieres, completa esto</span></div>

      <form id="contact-form" class="contact-form">
        <label>
          <span>¿Qué necesitas?</span>
          <select name="servicio">
            <option value="Necesito una página web.">Una página web</option>
            <option value="Necesito una tienda online.">Una tienda online</option>
            <option value="Necesito un software a medida.">Un software a medida</option>
            <option value="Todavía no tengo claro qué necesito.">Todavía no lo tengo claro</option>
          </select>
        </label>
        <label>
          <span>Tu nombre <span class="req">(obligatorio)</span></span>
          <input type="text" name="nombre" required autocomplete="name" />
        </label>
        <label>
          <span>Cuéntame un poco de tu negocio <span class="req">(opcional)</span></span>
          <textarea name="mensaje" rows="3"></textarea>
        </label>
        <button type="submit" class="btn btn-secondary" data-cta="contacto-form">
          Enviar por WhatsApp
        </button>
        <p class="contact-form-hint">
          Se abre WhatsApp con el mensaje ya escrito. Solo le das enviar.
        </p>
        <p class="contact-form-status" role="status"></p>
      </form>

      <p class="contact-alt">
        ¿Prefieres correo? <a href={`mailto:${EMAIL}`} data-cta="contacto-email">{EMAIL}</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href={LINKEDIN_URL} target="_blank" rel="noopener"
          >LinkedIn <span class="visually-hidden">(se abre en una nueva pestaña)</span></a
        >
      </p>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
  }

  .contact-card {
    --bracket-size: 24px;
    max-width: 780px;
    margin-inline: auto;
    text-align: center;
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-items: center;
  }

  .contact-card > p {
    font-family: var(--font-body);
    color: var(--text-secondary);
    max-width: 520px;
  }

  .contact-wa {
    font-size: 1.125rem;
    padding: 16px 30px;
    margin-top: var(--space-2);
  }

  .contact-card > .contact-number {
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.06em;
    color: var(--green);
    text-shadow: 0 0 8px rgba(var(--green-rgb), 0.4);
    margin-top: calc(var(--space-3) * -1);
  }

  .contact-divider {
    width: 100%;
    max-width: 420px;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .contact-divider::before,
  .contact-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--border-strong);
  }

  .contact-form {
    width: 100%;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    text-align: left;
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .contact-form .req {
    color: var(--text-tertiary);
    font-size: 0.8125rem;
  }

  .contact-form input,
  .contact-form textarea,
  .contact-form select {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--text-primary);
    background: var(--bg-elevated-2);
    /* #6b7389 keeps the field edge at 3:1+ against both the input and the
       card background (WCAG 1.4.11). */
    border: 1px solid #6b7389;
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    resize: vertical;
  }

  .contact-form input:focus-visible,
  .contact-form textarea:focus-visible,
  .contact-form select:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }

  .contact-form button {
    align-self: stretch;
  }

  .contact-form-hint {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    text-align: center;
  }

  .contact-form-status {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--green);
    text-align: center;
    min-height: 1em;
  }

  .contact-card > .contact-alt {
    font-size: 0.9375rem;
    color: var(--text-tertiary);
  }

  .contact-alt a {
    color: var(--cyan);
    border-bottom: 1px dashed rgba(var(--cyan-rgb), 0.5);
    overflow-wrap: anywhere;
  }

  .contact-alt a:hover,
  .contact-alt a:focus-visible {
    text-shadow: 0 0 8px rgba(var(--cyan-rgb), 0.5);
  }

  .contact-alt .sep {
    margin-inline: var(--space-2);
  }

  @media (max-width: 560px) {
    .contact-card {
      padding: var(--space-6) var(--space-5);
    }
  }
</style>

<script>
  import { waLink } from "../lib/contact";

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = form?.querySelector<HTMLElement>(".contact-form-status");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const servicio = ((data.get("servicio") as string) ?? "").trim();
    const nombre = ((data.get("nombre") as string) ?? "").trim();
    const mensaje = ((data.get("mensaje") as string) ?? "").trim();

    let text = `Hola Pablo, soy ${nombre}. ${servicio}`;
    if (mensaje) text += `\n\n${mensaje}`;

    const url = waLink(text);
    const win = window.open(url, "_blank");
    if (win) {
      win.opener = null;
    } else {
      // Pop-up blocked: open WhatsApp in this tab instead.
      window.location.href = url;
    }
    if (status) status.textContent = "Abriendo WhatsApp con tu mensaje…";
  });
</script>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Servicios from "../components/Servicios.astro";
import WebShowcase from "../components/WebShowcase.astro";
import Credibility from "../components/Credibility.astro";
import Clientes from "../components/Clientes.astro";
import ComoTrabajo from "../components/ComoTrabajo.astro";
import Faq from "../components/Faq.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout>
  <Header />
  <main id="main-content">
    <Hero />
    <Servicios />
    <Clientes />
    <WebShowcase />
    <Credibility />
    <ComoTrabajo />
    <Faq />
    <Contacto />
  </main>
  <Footer />
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { waLink } from "../lib/contact";

const waHref = waLink("Hola Pablo, leí tu página Sobre mí y quiero conversar sobre un proyecto 👋");

const valores = [
  {
    titulo: "Que dure",
    texto:
      "Prefiero hacerlo bien una vez que andar parchando después. Lo que hago está pensado para que le puedas agregar cosas sin rehacerlo.",
  },
  {
    titulo: "No desaparezco",
    texto:
      "Te voy mostrando avances y me puedes escribir directo cuando quieras. No vas a tener que perseguirme para saber cómo va.",
  },
  {
    titulo: "Herramientas conocidas",
    texto:
      "Uso lo mismo que usaba en bancos y en el Estado: Node.js, Java, Angular y AWS. Nada experimental.",
  },
];

const stack = ["Node.js", "NestJS", "Java", "Angular", "TypeScript", "Python", "AWS", "Docker"];
---

<BaseLayout
  title="Sobre mí · Pablo Cornejo, desarrollador freelance en Chile"
  description="Soy Pablo Cornejo, desarrollador freelance en Chile. Pasé más de 15 años en bancos y el Estado, y hoy hago webs, tiendas online y software para pymes."
  breadcrumbs={[{ name: "Sobre mí", path: "/sobre-mi/" }]}
>
  <Header />
  <main id="main-content">
    <section class="about">
      <div class="container about-inner">
        <div class="about-head">
          <div class="avatar" aria-hidden="true">PC</div>
          <span class="eyebrow">Sobre mí</span>
          <h1>Hola, soy <span class="accent">Pablo Cornejo</span></h1>
          <p class="about-sub">
            Hace más de 15 años que hago software, casi todo ese tiempo para bancos, el Estado y
            empresas de pagos. Hoy trabajo por mi cuenta con pymes y emprendedores en Chile.
          </p>
        </div>

        <div class="about-story">
          <h2>Cómo llegué a esto</h2>
          <p>
            Pasé años trabajando en plataformas bancarias, sistemas de gobierno e integraciones
            de pagos. Ahí un error se notaba al tiro y había que responder por él. Esa costumbre
            me la traje.
          </p>
          <p>
            Hoy programo apoyándome en IA, y eso me deja avanzar bastante más rápido que antes.
            Gracias a eso puedo tomar proyectos de negocios más chicos a un precio razonable, y
            con el mismo cuidado de siempre.
          </p>
          <p>
            Me gusta trabajar directo con el dueño, entender cómo funciona su negocio y hacerme
            cargo del proyecto completo. Si quieres ver un ejemplo, acá está
            <a href="/casos/gruas-sepu/">lo que hice para Grúas Sepu</a>.
          </p>
        </div>

        <div class="about-values">
          {
            valores.map((v) => (
              <div class="value-card corner-brackets">
                <h3>{v.titulo}</h3>
                <p>{v.texto}</p>
              </div>
            ))
          }
        </div>

        <div class="about-stack">
          <h2>Con qué trabajo</h2>
          <div class="stack-chips">
            {stack.map((t) => <span class="stack-chip">{t}</span>)}
          </div>
        </div>

        <div class="about-ctas">
          <a
            href={waHref}
            target="_blank"
            rel="noopener"
            class="btn btn-primary"
            data-cta="about-whatsapp"
          >
            Escríbeme por WhatsApp
            <span class="visually-hidden">(se abre en una nueva pestaña)</span>
          </a>
          <a href="/#servicios" class="btn btn-secondary">Ver servicios</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .about {
    background: var(--bg-base);
  }

  .about-inner {
    max-width: 820px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .about-head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2rem;
    color: var(--bg-base);
    background: radial-gradient(circle at 35% 30%, var(--cyan), var(--magenta));
    box-shadow:
      0 0 0 1px rgba(var(--cyan-rgb), 0.4),
      0 0 40px -8px rgba(var(--magenta-rgb), 0.6);
    margin-bottom: var(--space-2);
  }

  .about h1 {
    font-size: clamp(2rem, 3.2vw + 1rem, 2.9rem);
    font-weight: 900;
    line-height: 1.15;
  }

  .about h1 .accent {
    color: var(--magenta);
    text-shadow:
      0 0 18px rgba(var(--magenta-rgb), 0.55),
      0 0 42px rgba(var(--magenta-rgb), 0.25);
  }

  .about-sub {
    font-family: var(--font-body);
    color: var(--text-secondary);
    font-size: 1.0625rem;
    max-width: 620px;
  }

  .about-story {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about-story h2,
  .about-stack h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.4rem, 2vw + 1rem, 1.85rem);
    margin-bottom: var(--space-2);
  }

  .about-story p {
    font-family: var(--font-body);
    color: var(--text-secondary);
    font-size: 1.03125rem;
    line-height: 1.65;
  }

  .about-story a {
    color: var(--cyan);
    border-bottom: 1px dashed rgba(var(--cyan-rgb), 0.5);
  }

  .about-story a:hover,
  .about-story a:focus-visible {
    text-shadow: 0 0 8px rgba(var(--cyan-rgb), 0.5);
  }

  .about-values {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .value-card {
    --bracket-size: 16px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .value-card h3 {
    font-family: var(--font-sub);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--cyan);
  }

  .value-card p {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .stack-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .stack-chip {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
    color: var(--green);
    border: 1px solid rgba(var(--green-rgb), 0.35);
    background: rgba(var(--green-rgb), 0.06);
    padding: 7px 14px;
    border-radius: 2px;
  }

  .about-ctas {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-2);
  }

  @media (max-width: 720px) {
    .about-values {
      grid-template-columns: 1fr;
    }
  }
</style>
